# ============================================================================
# UZBEKISTAN SCHOOL ROAD SAFETY PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Environment (development, production, test)
NODE_ENV=development

# Backend REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Enable/Disable Mock Data Mode (true = Mock Repositories, false = Real Backend API)
NEXT_PUBLIC_USE_MOCK=true

# Public App Metadata
NEXT_PUBLIC_APP_NAME="O‘zbekiston Maktab Yo‘l Xavfsizligi Platformasi"
NEXT_PUBLIC_APP_VERSION="1.0.0"
